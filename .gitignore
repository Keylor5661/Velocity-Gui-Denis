speedLabel.Position = UDim2.new(0,15,0,48)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Velocidad actual"
speedLabel.TextColor3 = Color3.fromRGB(180,180,190)
speedLabel.TextSize = 14
speedLabel.Font = Enum.Font.Gotham
speedLabel.Parent = frame

local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0,110,0,35)
speedBox.Position = UDim2.new(0.5,-55,0,70)
speedBox.BackgroundColor3 = Color3.fromRGB(45,45,55)
speedBox.Text = "16"
speedBox.PlaceholderText = "Velocidad"
speedBox.TextColor3 = Color3.fromRGB(255,255,255)
speedBox.TextSize = 18
speedBox.Font = Enum.Font.GothamBold
speedBox.ClearTextOnFocus = false
speedBox.BorderSizePixel = 0
speedBox.Parent = frame

